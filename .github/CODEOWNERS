# CODEOWNERS — critical-path review gate for autonomous self-evolution.
#
# When branch protection on `main` has "Require review from Code Owners"
# enabled, any PR touching these paths needs @Lexus2016 approval before merge.
# This stops the evolution agent (or a prompt-injected proposal) from
# autonomously changing the self-update machinery, the scheduler, secrets
# handling, or CI — the parts that, if compromised, would break the safety
# gate itself. Everything else can flow through CI-gated automerge.

# Self-update + install machinery
/scripts/install_auto_update.sh    @Lexus2016
/scripts/setup_evolution_bot.sh    @Lexus2016
/scripts/register_evolution_cron.py @Lexus2016
/upgrade.sh                        @Lexus2016
/setup-hermes.sh                   @Lexus2016

# Scheduler / cron core
/cron/jobs.py                      @Lexus2016
/cron/scheduler.py                 @Lexus2016

# CI and repo automation (the gate itself)
/.github/                          @Lexus2016

# The evolution skills that decide what gets implemented/merged
/skills/evolution/                 @Lexus2016

# Additional upstream trust boundaries, reviewed by this fork owner.
# These paths request review from the fork owner. Enforcement depends on
# repository branch protection; this integration does not change or claim
# verification of those settings. Deterministic evolution gates remain separate.

/.github/                       @Lexus2016
/scripts/ci/                    @Lexus2016
# The code-health gate decides whether a PR passes; weakening it is a CI change.
/scripts/check                  @Lexus2016
/scripts/code_health/           @Lexus2016

# The committed system prompt + tools[] render every session sends (scripts/ci/prompt_surface.py).
# Prompt surfaces request fork-owner review; enforcement depends on branch protection.
/tests/fixtures/prompt_surface/ @Lexus2016

# eslint configs can define custom ``fix`` functions that run arbitrary code.
eslint.config.*                 @Lexus2016
/.prettierrc                    @Lexus2016

# MCP catalog entries define local commands users later install into
# ``mcp_servers``; the installer decides how they are fetched and run.
/optional-mcps/                 @Lexus2016
/hermes_cli/mcp_catalog.py      @Lexus2016

# Files that execute at pip-install or interpreter startup.
/setup.py                       @Lexus2016
/setup.cfg                      @Lexus2016
/sitecustomize.py               @Lexus2016
/usercustomize.py               @Lexus2016
*.pth                           @Lexus2016

# Dependency manifests, resolved pins, and image builds: an edit here changes
# what gets installed and run without touching any reviewed source.
pyproject.toml                  @Lexus2016
package.json                    @Lexus2016
uv.lock                         @Lexus2016
*package-lock.json              @Lexus2016
/flake.lock                     @Lexus2016
/pm/lock.json                   @Lexus2016
*Dockerfile                     @Lexus2016

# The npm supply-chain quarantine (min-release-age) lives here.
.npmrc                          @Lexus2016

# Where PM fetches artifacts from.
/pm/artifact-mirror.json        @Lexus2016

# The installers users pipe into a shell, and the generator for the pins they carry.
/scripts/install.sh             @Lexus2016
/scripts/install.ps1            @Lexus2016
/scripts/install.cmd            @Lexus2016
/scripts/gen-bootstrap-pins.py  @Lexus2016

# The trust model and the scope authority for security reports.
/SECURITY.md                    @Lexus2016

# Each entry pins a third-party repo by sha; editing it changes what users install.
/plugin-catalog/                @Lexus2016

# One-time upstream debt evidence still requires owner-directed review.
/analysis/sync-health/           @Lexus2016
